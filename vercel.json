{
  "rewrites": [
    {
      "source": "/api/feishu/:path*",
      "destination": "https://open.feishu.cn/open-apis/:path*"
    },
    {
      "source": "/api/deepseek/:path*",
      "destination": "https://api.deepseek.com/:path*"
    },
    {
      "source": "/api/jina/:path*",
      "destination": "https://r.jina.ai/:path*"
    }
  ]
}
